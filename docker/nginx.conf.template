# ${PORT} est remplacé au démarrage (envsubst).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${PORT};
    server_name _;
    client_max_body_size 14M;

    # Angular : application monopage, toute adresse inconnue renvoie index.html.
    root /var/www/frontend;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Fichiers Angular (nom avec empreinte, changé à chaque build) : mis en cache longtemps.
    location ~* \.(?:js|css|woff2?)$ {
        try_files $uri =404;
        expires 30d;
        access_log off;
    }

    # Icônes et images de public/ : même nom d'une version à l'autre, cache court.
    location ~* \.(?:png|jpe?g|svg|ico|webp)$ {
        try_files $uri =404;
        expires 1h;
        access_log off;
    }

    # La page d'accueil n'est jamais gardée en cache : elle pointe vers les fichiers du dernier build.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # API Laravel et contrôle de santé.
    location ~ ^/(api|up)(/|$) {
        root /var/www/backend/public;
        try_files $uri /index.php?$query_string;
    }

    location = /index.php {
        root /var/www/backend/public;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTPS on;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_read_timeout 60s;
    }

    # Logos, photos et documents publics (storage:link).
    location ^~ /storage/ {
        root /var/www/backend/public;
        try_files $uri =404;
    }

    # Reverb (WebSocket du buzzer) : même adresse que le site, pas de CORS ni de port à ouvrir.
    location ^~ /app/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }
}
